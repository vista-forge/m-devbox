{
  "code-runner.executorMap": {
    "mumps": "m-run $fullFileName"
  },
  "code-runner.executorMapByFileExtension": {
    ".m": "m-run $fullFileName"
  },
  "code-runner.runInTerminal": false,
  "code-runner.showExecutionMessage": false,
  "code-runner.clearPreviousOutput": true,

  "security.workspace.trust.enabled": false,

  "// startupEditor": "readme opens a workspace folder's README on first load — the docs folder carries one. This is how the start page opens WITHOUT a second CLI path, which would drop the workspace entirely (G31).",
  "workbench.startupEditor": "readme",

  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,

  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "errorLens.followCursor": "allLines",
  "errorLens.messageMaxChars": 140,

  "files.associations": {
    "*.m": "mumps"
  }
}
